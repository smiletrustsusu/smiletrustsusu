{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smiletrust.com/baseline/enterprise-baseline-artifact.schema.json",
  "title": "EibprfbsEnterpriseBaselineArtifact",
  "description": "Phase 20 EIBPRFBS baseline artifact for a Module (1–30) or prior Phase (1–19). Integrates by reference; does not redefine prior specs or replace engines. additionalProperties false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "kind",
    "title",
    "version",
    "status",
    "accountableAuthority",
    "effectiveDate",
    "governance",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "artifactId": {
      "$ref": "#/$defs/artifactId"
    },
    "kind": {
      "$ref": "#/$defs/artifactKind"
    },
    "moduleId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "phaseNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 19
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "$ref": "#/$defs/baselineStatus"
    },
    "accountableAuthority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "effectiveDate": {
      "type": "string",
      "format": "date"
    },
    "primaryDoc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260
    },
    "registryPath": {
      "type": ["string", "null"],
      "maxLength": 260
    },
    "enginesNotReplaced": {
      "type": "boolean"
    },
    "contentNotRedefined": {
      "type": "boolean"
    },
    "moneyInvariantGuard": {
      "type": "boolean"
    },
    "approvalRecord": {
      "$ref": "#/$defs/approvalRecord"
    },
    "traceability": {
      "$ref": "#/$defs/traceability"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^BL-(MOD|PH)-[0-9]{3}$"
    },
    "artifactKind": {
      "type": "string",
      "enum": ["module", "phase"]
    },
    "baselineStatus": {
      "type": "string",
      "enum": ["draft", "baselined", "published", "superseded", "retired"]
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "accountableAuthority"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending_package", "approved", "rejected", "expired"]
        },
        "accountableAuthority": { "type": "string", "minLength": 1 },
        "approvingBody": { "type": "string" },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" },
        "approvalRef": { "type": ["string", "null"] },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emasRef": { "type": "string" },
        "baselinePhase": { "type": "integer", "const": 20 },
        "priorSpecsConsumed": { "type": "boolean" },
        "integratesInto": { "type": "string" },
        "priorSpecsAuthoritative": { "type": "boolean" },
        "schemaManifest": { "type": ["string", "null"] }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountableAuthority", "auditAuthority"],
      "properties": {
        "accountableAuthority": { "type": "string", "minLength": 1 },
        "responsibleParty": { "type": "string" },
        "auditAuthority": { "type": "string", "minLength": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "createdBy", "phase"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1 },
        "phase": { "type": "integer", "const": 20 },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "moneyInvariantsNote": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
