{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smiletrust.com/baseline/enterprise-certification.schema.json",
  "title": "EibprfbsEnterpriseCertification",
  "description": "Phase 20 enterprise certification or acceptance decision record. Distinct from Phase 16 CERT-001/002 release certs (consumed, not redefined). additionalProperties false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "certificationId",
    "recordKind",
    "decision",
    "issuedAt",
    "governance",
    "evidence",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "recordId": {
      "$ref": "#/$defs/uuid"
    },
    "certificationId": {
      "type": "string",
      "pattern": "^(CERT-BL|ACC)-[0-9]{3}$"
    },
    "recordKind": {
      "type": "string",
      "enum": ["certification", "acceptance"]
    },
    "certificationType": {
      "type": "string",
      "enum": [
        "application",
        "infrastructure",
        "security",
        "data",
        "performance",
        "backup",
        "dr",
        "ops",
        "governance",
        "compliance"
      ]
    },
    "acceptanceType": {
      "type": "string",
      "enum": [
        "technical",
        "business",
        "operational",
        "security",
        "executive",
        "regulatory"
      ]
    },
    "decision": {
      "type": "string",
      "enum": ["certified", "accepted", "rejected", "pending", "expired"]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "renewalRequired": { "type": "boolean" },
    "entryCriteriaMet": { "type": "boolean" },
    "approvalRolesSatisfied": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "relatedReadinessIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^RDY-[0-9]{3}$" },
      "uniqueItems": true
    },
    "phase16Align": {
      "type": "string",
      "pattern": "^CERT-[0-9]{3}$",
      "description": "Optional consume-link to Phase 16 CERT-* — not a redefinition"
    },
    "governance": { "$ref": "#/$defs/governance" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "uri"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "test_report",
            "drill_report",
            "audit_pack",
            "signoff",
            "schema_manifest",
            "runbook",
            "other"
          ]
        },
        "uri": { "type": "string", "minLength": 1, "maxLength": 500 },
        "checksum": {
          "type": "string",
          "pattern": "^SHA-256:[a-f0-9]{64}$"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountableAuthority", "auditAuthority"],
      "properties": {
        "accountableAuthority": { "type": "string", "minLength": 1 },
        "responsibleParty": { "type": "string" },
        "auditAuthority": { "type": "string", "minLength": 1 },
        "approver": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "createdBy", "phase"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1 },
        "phase": { "type": "integer", "const": 20 },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "moneyInvariantsNote": { "type": "string", "maxLength": 200 },
        "specificationBaselineOnly": {
          "type": "boolean",
          "description": "true when record is catalog/spec baseline evidence, not live production certification"
        }
      }
    }
  }
}
