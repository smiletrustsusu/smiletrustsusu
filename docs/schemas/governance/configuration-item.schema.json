{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smiletrust.com/governance/configuration-item.schema.json",
  "title": "EgccrmsConfigurationItem",
  "description": "Phase 19 EGCCRMS CMDB configuration item. Catalog/governance only; does not redefine Phase 8 config semantics or Phase 14 pipelines. additionalProperties false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ciId",
    "name",
    "category",
    "status",
    "version",
    "baselineId",
    "governance",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "ciId": {
      "$ref": "#/$defs/ciId"
    },
    "code": {
      "type": "string",
      "pattern": "^CI_[A-Z0-9_]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "category": {
      "$ref": "#/$defs/ciCategory"
    },
    "status": {
      "$ref": "#/$defs/ciStatus"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "baselineId": {
      "type": "string",
      "pattern": "^BL-[A-Z0-9-]{2,64}$"
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/ciId" },
      "uniqueItems": true
    },
    "relatedModules": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 30 },
      "uniqueItems": true
    },
    "relatedPhases": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 19 },
      "uniqueItems": true
    },
    "artifactPath": {
      "type": "string",
      "maxLength": 256
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "moneyInvariantGuard": {
      "type": "boolean"
    },
    "consumesPhase8": { "type": "boolean" },
    "consumesPhase14": { "type": "boolean" },
    "consumesPhase13": { "type": "boolean" },
    "advisoryOnly": { "type": "boolean" },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "ciId": {
      "type": "string",
      "pattern": "^CI-[0-9]{3}$"
    },
    "ciCategory": {
      "type": "string",
      "enum": [
        "android_apk",
        "web_portal",
        "api",
        "database",
        "infrastructure",
        "certificate",
        "secret_ref",
        "ai_model",
        "report",
        "pipeline",
        "monitoring_config",
        "configuration"
      ]
    },
    "ciStatus": {
      "type": "string",
      "enum": ["planned", "registered", "baselined", "in_change", "retired"]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountableAuthority", "responsibleParty", "auditAuthority"],
      "properties": {
        "accountableAuthority": { "type": "string", "minLength": 1 },
        "responsibleParty": { "type": "string", "minLength": 1 },
        "auditAuthority": { "type": "string", "minLength": 1 },
        "ownerRoleId": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "createdBy", "phase"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1 },
        "phase": { "type": "integer", "const": 19 },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "moneyInvariantsNote": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
