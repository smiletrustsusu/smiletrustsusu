{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smiletrust.com/common/module-ref.schema.json",
  "title": "SmileTrustModuleReference",
  "description": "Reference to an EMAS module (1–30).",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "moduleName"],
  "properties": {
    "moduleId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "moduleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "role": {
      "type": "string",
      "enum": ["Owner", "Consumer", "Producer", "Advisor", "Controller"],
      "default": "Consumer"
    }
  }
}
